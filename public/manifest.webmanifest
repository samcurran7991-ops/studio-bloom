{
  "name": "Studio Leads",
  "short_name": "Leads",
  "description": "Every Instagram, Meta and Google lead for your studio, with instant alerts and texting.",
  "id": "/app",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F5F0EE",
  "theme_color": "#8E2F4A",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Needs reply", "url": "/app/leads", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Callbacks", "url": "/app/callbacks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
